<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="mreader.MainPage"
             Title="MReader"
             Shell.NavBarIsVisible="False">
    <ContentPage.Resources>
        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#252525" Offset="0" />
            <GradientStop Color="#3A3A3A" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#4A4A4A" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinimumHeightRequest" Value="36" />
            <Setter Property="MinimumWidthRequest" Value="36" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*" BackgroundColor="{AppThemeBinding Light=#F7F7FB, Dark=#101015}">
        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" StrokeThickness="0" StrokeShape="RoundRectangle 0,0,28,28">
            <Grid Padding="22,18,22,22" RowDefinitions="Auto,Auto,Auto" RowSpacing="14">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border WidthRequest="42" HeightRequest="42" BackgroundColor="#D0D0D0" StrokeThickness="0" StrokeShape="RoundRectangle 14" VerticalOptions="Center">
                        <Label Text="M" TextColor="#252525" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                        <Label Text="MReader" TextColor="White" FontSize="22" FontAttributes="Bold" />
                        <Label Text="Your offline manga library" TextColor="#D0D0D0" FontSize="12" />
                    </VerticalStackLayout>
                    <Button Grid.Column="2" Text="Change folder" Style="{StaticResource HeaderButton}" Clicked="OnChangeFolderClicked" />
                </Grid>

                <Border Grid.Row="1" BackgroundColor="#333333" Stroke="#555555" StrokeShape="RoundRectangle 14" Padding="12,9">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Label Text="LIBRARY" TextColor="#D0D0D0" FontSize="10" FontAttributes="Bold" VerticalOptions="Center" />
                        <Label x:Name="CurrentPathLabel" Grid.Column="1" Text="Choose a manga directory" TextColor="#F7F5FF" FontSize="12" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                        <Button Grid.Column="2" Text="↻" Style="{StaticResource HeaderButton}" FontSize="17" Padding="8,2" Clicked="OnRefreshClicked" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Button x:Name="BackButton" Text="← Back" Style="{StaticResource HeaderButton}" IsVisible="False" Clicked="OnBackClicked" />
                    <Label Grid.Column="1" Text="Browse folders or start reading" TextColor="#D0D0D0" FontSize="12" VerticalOptions="Center" HorizontalOptions="End" />
                </Grid>
            </Grid>
        </Border>

        <CollectionView x:Name="LibraryItems" Grid.Row="1" Margin="14,14,14,0" SelectionMode="None" SizeChanged="OnLibrarySizeChanged">
            <CollectionView.ItemsLayout>
                <GridItemsLayout x:Name="LibraryLayout" Orientation="Vertical" Span="2" HorizontalItemSpacing="8" VerticalItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="36" Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                    <Border WidthRequest="78" HeightRequest="78" BackgroundColor="{AppThemeBinding Light=#E8E8E8, Dark=#303030}" StrokeThickness="0" StrokeShape="RoundRectangle 28">
                        <Label Text="M" TextColor="{AppThemeBinding Light=#383838, Dark=#D0D0D0}" FontSize="32" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="Your shelf is empty" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                    <Label Text="Add manga folders or ZIP archives to this directory, then refresh." FontSize="12" TextColor="{StaticResource Gray500}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Spacing="4">
                        <Border Padding="0" HeightRequest="{Binding CardHeight}" BackgroundColor="{AppThemeBinding Light=#E8E8E8, Dark=#303030}" StrokeThickness="0" StrokeShape="RoundRectangle 12">
                            <Grid>
                                <Image Source="{Binding CoverPath}" IsVisible="{Binding IsManga}" Aspect="AspectFill" />
                                <BoxView IsVisible="{Binding IsFolder}" Color="{AppThemeBinding Light=#D8D8D8, Dark=#3B3B3B}" />
                                <Image Source="folder.png" IsVisible="{Binding IsFolder}" WidthRequest="92" HeightRequest="74" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
                                <Border IsVisible="{Binding IsManga}" BackgroundColor="#95000000" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="8,4" HorizontalOptions="End" VerticalOptions="Start" Margin="8">
                                    <Label Text="READ" TextColor="White" FontSize="10" FontAttributes="Bold" />
                                </Border>
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer NumberOfTapsRequired="2" Tapped="OnItemDoubleTapped" />
                            </Border.GestureRecognizers>
                        </Border>
                        <Label Text="{Binding Name}" FontSize="13" FontAttributes="Bold" LineBreakMode="TailTruncation" MaxLines="1" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <Label Text="{Binding KindLabel}" FontSize="11" TextColor="{StaticResource Gray500}" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="Open" IsVisible="{Binding IsFolder}" FontSize="10" Padding="7,2" MinimumHeightRequest="26" MinimumWidthRequest="48" Clicked="OnOpenFolderClicked" />
                            <Button Grid.Column="1" Text="Read" IsVisible="{Binding IsManga}" FontSize="10" Padding="7,2" MinimumHeightRequest="26" MinimumWidthRequest="48" Clicked="OnReadClicked" />
                        </Grid>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
