<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
						 xmlns:components="clr-namespace:mreader.Views.Components"
             x:Class="mreader.MainPage">

	<ScrollView>
		<VerticalStackLayout>
			<HorizontalStackLayout>
				<Button Text="Read"
                Clicked="OnClickGoView" />
				<Button Text="Browse"
                Clicked="OnClickGoView" />
			</HorizontalStackLayout>
			<components:FileBrowser />
		</VerticalStackLayout>
	</ScrollView>

</ContentPage>
