<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="mreader.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:mreader.Views.Pages"
    xmlns:local="clr-namespace:mreader"
    Title="MReader">

	<ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />
	
	<ShellContent
		    Title="Image View"
		    ContentTemplate="{DataTemplate pages:ImageViewPage}"
		    Route="ImageView" />

</Shell>
