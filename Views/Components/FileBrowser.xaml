<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="mreader.Views.Components.FileBrowser">
	<ScrollView>
		<FlexLayout 
      Direction="Row"
      Wrap="Wrap"
      JustifyContent="Center"
      AlignItems="Start"
      BindableLayout.ItemsSource="{Binding ImagePaths}">

			<BindableLayout.ItemTemplate>
				<DataTemplate>
					<Frame Padding="2" HasShadow="False" BorderColor="Gray">
						<Image Source="{Binding}"
                         WidthRequest="160"
                         HeightRequest="200"
                         Aspect="AspectFill"/>
					</Frame>
				</DataTemplate>
			</BindableLayout.ItemTemplate>
		</FlexLayout>
	</ScrollView>
</ContentView>
